<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Button Width="120" Height="40"
                        Classes="DefaultDarkButton"
                        Content="Test"/>
                <Button Width="120" Height="40"
                        IsEnabled="False"
                        Classes="DefaultDarkButton"
                        Content="Test"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Button Width="120" Height="40"
                        Classes="LightDarkButton"
                        Content="Test"/>
                <Button Width="120" Height="40"
                        IsEnabled="False"
                        Classes="LightDarkButton"
                        Content="Test"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Button Width="30" Height="30"
                        Classes="LightImageDarkButton">
                    <Image Source="/Assets/Issue/New.png"/>
                </Button>
                <Button Width="30" Height="30"
                        IsEnabled="False"
                        Classes="LightImageDarkButton"
                        Content="Test">
                    <Image Source="/Assets/Issue/New.png"/>
                </Button>
            </DockPanel>
        </DockPanel>
    </Design.PreviewWith>
    <!--Button-->
    <Style Selector="Button.DefaultDarkButton">
        <Setter Property="Foreground" Value="#8f8f8f"/>
        <Setter Property="Background" Value="#333333"/>
    </Style>
    <Style Selector="Button.DefaultDarkButton:pointerover">
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Background" Value="#ea5e27"/>
    </Style>
    <Style Selector="Button.DefaultDarkButton:disabled">
        <Setter Property="Foreground" Value="#8f8f8f"/>
        <Setter Property="Background" Value="#5f5f5f"/>
    </Style>

    <Style Selector="Button.LightDarkButton">
        <Setter Property="Foreground" Value="#8f8f8f"/>
        <Setter Property="Background" Value="#5f5f5f"/>
    </Style>
    <Style Selector="Button.LightDarkButton:pointerover">
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Background" Value="#ea5e27"/>
    </Style>
    <Style Selector="Button.LightDarkButton:disabled">
        <Setter Property="Foreground" Value="#5f5f5f"/>
        <Setter Property="Background" Value="#7f7f7f"/>
    </Style>

    <Style Selector="Button.LightImageDarkButton">
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Foreground" Value="#8f8f8f"/>
        <Setter Property="Background" Value="LightGray"/>
    </Style>
    <Style Selector="Button.LightImageDarkButton:pointerover">
        <Setter Property="Foreground" Value="#8f8f8f"/>
        <Setter Property="Background" Value="#ea5e27"/>
    </Style>
    <Style Selector="Button.LightImageDarkButton:disabled">
        <Setter Property="Foreground" Value="#8f8f8f"/>
        <Setter Property="Background" Value="DarkGray"/>
    </Style>
</Styles>
