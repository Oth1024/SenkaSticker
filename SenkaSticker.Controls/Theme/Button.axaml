<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
    <Border Width="32" Height="32" Classes="ButtonBackground">
        <PathIcon Classes="ButtonStroke" Width="32" Height="32"
                  Data="M0,2 L2,2 L2,0 L4,0 L4,2 L6,2 L6,4 L4,4 L4,6 L2,6 L2,4 L0,4 L0,2">
            
        </PathIcon>
    </Border>
    </Design.PreviewWith>
    <Style Selector="Border.ButtonBackground">
        <Setter Property="Background" Value="#1f1f1f"/>
    </Style>
    <Style Selector="Border.ButtonBackground:pointerover">
        <Setter Property="Background" Value="#ea5e27"/>
    </Style>
    <Style Selector="Border.ButtonBackground>PathIcon.ButtonStroke">
        <Setter Property="Background" Value="#ea5e27"/>
    </Style>
  <!-- Add Styles Here -->
</Styles>
